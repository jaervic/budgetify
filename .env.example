# Sincronización opcional (Supabase).
#
# Sin estas variables la app funciona como siempre: 100 % local, sin cuentas.
# Para activarla, copia este archivo a `.env.local` y completa los valores.
#
# En la demo pública se deja `VITE_SYNC_ENABLED=false` para no almacenar datos
# reales de pacientes. La app real se despliega con `true`.

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key
VITE_SYNC_ENABLED=true
